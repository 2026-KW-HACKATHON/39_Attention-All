# 복사해서 mobile/.env.local로 저장한다(.env.local은 커밋되지 않는다). EXPO_PUBLIC_ 값은 앱 번들에 들어가는 공개 값이다.
# 서비스 계정 키·관리자 인증값·CLI 토큰은 어떤 경우에도 넣지 않는다.

# 연결 대상(필수): emulator = 개발 PC의 Firebase Emulator(demo-uirun) / firebase = 기존 Firebase 프로젝트(uirun-92539)
EXPO_PUBLIC_UIRUN_TARGET=emulator

# emulator 대상의 PC 주소. Android Emulator는 10.0.2.2, 실기기는 PC의 LAN 주소(예: 192.168.0.12)
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2

# firebase 대상 + 개발 빌드에서만 사용. Firebase 콘솔 App Check에 등록한 디버그 토큰(개인 값, 공유·커밋 금지).
# 비워 두면 앱이 디버그 토큰을 만들어 logcat에 출력한다(mobile/README.md). 릴리스 빌드에는 넣지 않는다.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# 실제 지도 표시용 Android Maps SDK 키. 패키지·개발 서명 SHA-1·Maps SDK로 제한한 키를 넣고 prebuild로 재빌드한다.
GOOGLE_MAPS_API_KEY=
