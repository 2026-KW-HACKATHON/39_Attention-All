rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /evidence/{uid}/{ticketId}/original.jpg {
   allow read: if request.auth != null && request.auth.uid == uid && !firestore.exists(/databases/(default)/documents/accountBlocks/$(uid));
   allow create: if resource == null && request.auth != null && request.auth.uid == uid
     && !firestore.exists(/databases/(default)/documents/accountBlocks/$(uid))
     && firestore.exists(/databases/(default)/documents/captureGrants/$(ticketId))
     && firestore.get(/databases/(default)/documents/captureGrants/$(ticketId)).data.uid == uid
     && firestore.get(/databases/(default)/documents/captureGrants/$(ticketId)).data.shutterAt != null
     && firestore.get(/databases/(default)/documents/captureGrants/$(ticketId)).data.consumed == false
     && request.time.toMillis() < firestore.get(/databases/(default)/documents/captureGrants/$(ticketId)).data.shutterAt + 60 * 60 * 1000
     && request.resource.size <= 5 * 1024 * 1024
     && request.resource.contentType == 'image/jpeg';
   allow update, delete: if false;
  }
  // No public bucket files. Owner/admin/public-approved thumbnails use short signed URLs.
  match /{allPaths=**} { allow read, write: if false; }
 }
}
