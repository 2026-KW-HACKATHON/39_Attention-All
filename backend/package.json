{
  "name": "uirun-backend-workspace",
  "private": true,
  "scripts": {
    "test": "npm --prefix functions test",
    "check": "npm --prefix functions run check",
    "emulators": "firebase emulators:start --project demo-uirun --only auth,firestore,functions,storage",
    "test:rules": "firebase emulators:exec --project demo-uirun --only firestore,storage 'npm --prefix functions run test:rules'",
    "test:smoke": "firebase emulators:exec --project demo-uirun --only auth,firestore,functions,storage 'node functions/test/smoke.cjs'"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0"
  }
}
